# PostgreSQL
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex
POSTGRES_DB=cortex
POSTGRES_PORT=5432

# SQLAlchemy async connection string
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex

# Copy to .env and fill in from your GitHub App settings page.
# https://github.com/settings/apps -> your app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
FRONTEND_URL=http://localhost:5173

# Session cookie signing key.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Optional in dev (one is generated, with a warning). Required for anything
# deployed -- multiple workers would reject each other's cookies.
SESSION_SECRET_KEY=